extends partial/layout

block site_title
    != page.title + " · " + config.title

block description
    - var desc = page.desc || page.title + " · " + config.title;
    meta(name="description", content=desc)

block content
    .autopagerize_page_element: .content
        .notes-page
            p.post-title Notes
            .notes-slide-grid
                a.notes-slide-card(href="/slides/start-writing/", title="重新开始写作")
                    p.notes-slide-title 重新开始写作
                    .notes-slide-cover
                        img(src="/slides/start-writing/cover.svg", alt="重新开始写作")
